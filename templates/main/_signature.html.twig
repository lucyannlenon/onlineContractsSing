{% if signature is defined and signature %}
    <section class="signature-panel" aria-labelledby="signature-title">
        <div class="signature-panel__header">
            <div class="signature-panel__title">
                <span class="signature-panel__icon" aria-hidden="true">
                    <i class="fa-solid fa-file-shield"></i>
                </span>
                <div>
                    <h2 id="signature-title">Documento assinado eletronicamente</h2>
                    <p>Assinatura vinculada ao conteúdo deste documento, com registro de data, hora e identificação técnica do acesso.</p>
                </div>
            </div>
            <span class="signature-badge">
                <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                Assinado
            </span>
        </div>

        <div class="signature-stamp">
            <div class="signature-meta">
                <span class="signature-meta__label">Assinado em</span>
                <span class="signature-meta__value">{{ signature_date }}</span>
            </div>
            <div class="signature-meta">
                <span class="signature-meta__label">Verificador</span>
                <code class="signature-token">{{ signature|slice(0, 24) }}</code>
            </div>
        </div>

        <p class="signature-note">A integridade deste documento foi registrada por assinatura eletrônica vinculada ao conteúdo apresentado no momento do aceite.</p>

        {% if is_pdf is defined and is_pdf %}
            {# Self-contained validation data embedded in the document itself, so
               the PDF stays verifiable even if the signature record is purged. #}
            <div class="signature-validation">
                <span class="signature-meta__label">Assinatura criptográfica (RSA-SHA256)</span>
                <code class="signature-hash">{{ signature }}</code>

                {% if signature_evidence_base64 is defined and signature_evidence_base64 %}
                    <span class="signature-meta__label">Evidência da assinatura (base64)</span>
                    <code class="signature-hash">{{ signature_evidence_base64 }}</code>
                {% endif %}

                <p class="signature-note signature-validation__hint">Documento autovalidável: a integridade pode ser reverificada com a chave pública da IZI Internet aplicada sobre a evidência e a assinatura acima.</p>
            </div>
        {% else %}
            <details class="signature-technical">
                <summary>Dados técnicos da assinatura</summary>
                <span class="signature-meta__label">Assinatura criptográfica</span>
                <code class="signature-hash">{{ signature }}</code>

                {% if signature_evidence_base64 is defined and signature_evidence_base64 %}
                    <span class="signature-meta__label">Evidência em base64</span>
                    <code class="signature-hash">{{ signature_evidence_base64 }}</code>
                {% endif %}
            </details>
        {% endif %}
    </section>
{% endif %}
