{% extends 'base.html.twig' %}

{% block title %}Contrato{% endblock %}

{% block body %}

    <div class="app-container document-flow">
        {% include 'main/_stepper.html.twig' with {current_step: 2} %}

        <article class="contract-document">
            {{ contract.template | raw }}

            {% include 'main/_signature.html.twig' %}
        </article>

        {% include 'main/_accept-button.html.twig' with {label: 'Aceitar termos do contrato e continuar'} %}
    </div>

{% endblock %}
