{% extends 'base.html.twig' %}

{% block title %}Contrato Assinado{% endblock %}

{% block body %}
    <div class="app-container document-flow">
        {% include 'main/_stepper.html.twig' with {document_title: 'Assinatura concluída'} %}

        <section class="success-card">
            <div class="success-card__mark" aria-hidden="true">
                <i class="fa-solid fa-check"></i>
            </div>
            <div class="eyebrow">Contrato assinado</div>
            <h1>Contrato assinado com sucesso</h1>
            <p>Seu contrato foi assinado com sucesso. Uma cópia em PDF do contrato estará disponível na sua área de assinante dentro de 7 dias.</p>
            <div class="success-card__divider"></div>
            <p>Em caso de dúvida, fale com a equipe de suporte pelos canais no rodapé.</p>
        </section>
    </div>
{% endblock %}
